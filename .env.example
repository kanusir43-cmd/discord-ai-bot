# Discord Bot Token (получить на https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# OpenRouter API Key (получить на https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ID канала где бот будет отвечать (необязательно, если не указан - отвечает везде)
# CHANNEL_ID=123456789012345678
